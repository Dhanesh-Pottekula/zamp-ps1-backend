RULES_TOLERANCE_PCT=2.0
# Absolute tolerance floor per PO currency (JSON); a currency not listed uses the percentage alone.
RULES_TOLERANCE_FLOORS={"INR": 500, "USD": 10, "EUR": 10, "GBP": 10, "JPY": 1000}
# A vendor is identified only when its signals add up to MORE than this score (the sum is capped at 100).
RULES_PASS_SCORE=80
# Points an invoice field earns when it equals the vendor master (JSON). A name alone must stay below the pass score.
RULES_VENDOR_WEIGHTS={"tax_id": 80, "bank_account": 60, "name": 30}
# A line match is sure only when its description scores ABOVE this (0-100) and no other PO line in the pool scores at
# or above the candidate cut-off; otherwise Jev decides the line.
RULES_LINE_SURE_ABOVE=90
RULES_LINE_CANDIDATE_AT=70
# A sure match must also cover most of the PO description (token-sort ratio at or above this), so a short invoice
# word that sits inside a different item ("Monitor" in "Monitor arm") is never matched without Jev.
RULES_LINE_COVERAGE_AT=80
# With no PO number printed, the vendor's open POs searched (newest first).
RULES_PO_POOL_MAX=10
RULES_MAX_PAGES=10
RULES_MAX_BYTES=20971520
