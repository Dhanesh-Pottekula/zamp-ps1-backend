# auto: live when TYPESAFE_API_KEY is set in backend/.env, else replay recorded answers; or force live / recorded.
JEV_MODE=auto
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT=10
# A PO is selected above this probability of yes, rejected at or below the next one, and unsure in between.
JEV_SELECT_ABOVE=0.80
JEV_REJECT_AT_OR_BELOW=0.50
JEV_MAX_CANDIDATES=10
# true writes every live answer to the recordings file, so recorded mode can replay it without a key.
JEV_RECORD=false
JEV_RECORDINGS=data/jev_recordings.json
